# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server only. Used for admin jobs such as expiry reminder emails. Never expose this to the browser or the app.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the website, used to build share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the Promote and Submit songs pages
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
