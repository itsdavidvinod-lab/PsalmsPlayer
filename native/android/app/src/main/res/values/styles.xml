<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The theme the app runs in (Capacitor switches to it once the window exists). The website is black, so everything the
         website does not paint (behind the status bar and the gesture bar, before the first page) is black too. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/pp_black</item>
        <item name="android:statusBarColor">@color/pp_black</item>
        <item name="android:navigationBarColor">@color/pp_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The launch window: black, with the app icon on Android 12 and newer. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pp_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:background">@color/pp_black</item>
    </style>
</resources>
